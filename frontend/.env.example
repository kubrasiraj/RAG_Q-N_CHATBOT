# Copy to .env for local development:  Copy-Item .env.example .env
#
# Leave VITE_API_BASE_URL unset in development. The Vite dev server proxies /api to
# VITE_PROXY_TARGET, so the browser talks to one origin and the backend needs no CORS.
# Setting an absolute URL here (e.g. https://api.example.com/api/v1) means the browser calls the
# backend directly, which requires the backend to allow your frontend origin via CORS.
# VITE_API_BASE_URL=/api/v1

# Where the dev server (and `npm run preview`) forwards /api requests.
VITE_PROXY_TARGET=http://localhost:8000

# UI-side upload limit. Keep it equal to the backend's MAX_DOCUMENT_SIZE_MB (default 20).
# The backend does not expose this value through an API, and its check is authoritative.
VITE_MAX_UPLOAD_MB=20
