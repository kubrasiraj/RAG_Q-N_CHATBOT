APP_NAME=Document Q&A RAG
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

POSTGRES_DB=document_qa_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+psycopg://rag_user:CHANGE_ME@localhost:5433/document_qa_rag

MAX_DOCUMENT_SIZE_MB=20
STORAGE_DIR=storage/documents

JWT_SECRET_KEY=GENERATE_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=32

CHUNK_SIZE_TOKENS=400
MAX_CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=60

GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_COMPLETION_TOKENS=800
GROQ_TEMPERATURE=0.1
